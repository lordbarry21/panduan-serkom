{
  "name": "panduan-serkom",
  "displayName": "Panduan Serkom",
  "description": "Pendamping belajar Laravel dari materi Serkom Bari: lokasi file, kode asli, dan langkah berikutnya.",
  "version": "1.2.0",
  "publisher": "bari-achmad-local",
  "author": "Bari Achmad",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/lordbarry21/panduan-serkom.git"
  },
  "homepage": "https://github.com/lordbarry21/panduan-serkom#readme",
  "bugs": {
    "url": "https://github.com/lordbarry21/panduan-serkom/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Education"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "serkom.open",
        "title": "Serkom: Buka Panduan",
        "icon": "$(book)"
      },
      {
        "command": "serkom.next",
        "title": "Serkom: Selesai dan Lanjut"
      },
      {
        "command": "serkom.previous",
        "title": "Serkom: Langkah Sebelumnya"
      }
    ],
    "keybindings": [
      {
        "command": "serkom.open",
        "key": "ctrl+alt+shift+s",
        "mac": "cmd+alt+shift+s"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "serkom",
          "title": "Panduan Serkom",
          "icon": "media/book.svg"
        }
      ]
    },
    "views": {
      "serkom": [
        {
          "id": "serkom.guide",
          "name": "Langkah belajar",
          "type": "webview"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Membaca panduan bisa tanpa trust. Mengubah file membutuhkan workspace tepercaya."
    }
  },
  "scripts": {
    "test": "node --test test/engine.test.js test/bonus.test.js",
    "test:ui": "node test/ui-check.js",
    "test:host": "node test/run-host.js",
    "notes:build": "node scripts/build-notes.js",
    "bonus:build": "node scripts/build-bonus.js",
    "package": "node scripts/package.js"
  },
  "files": [
    "src/**",
    "media/**",
    "data/**",
    "docs/*.png",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "playwright": "1.64.1"
  }
}
